{
  "name": "inventory-app-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:admin": "npm run dev --workspace=@inventory-app/admin",
    "build:admin": "npm run build --workspace=@inventory-app/admin",
    "dev:catalogo": "npm run dev --workspace=@inventory-app/catalogo",
    "build:catalogo": "npm run build --workspace=@inventory-app/catalogo"
  },
  "dependencies": {
    "core-js": "^3.49.0",
    "es-abstract": "^1.24.2"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "*",
    "@rollup/rollup-linux-x64-gnu": "*",
    "@rollup/rollup-linux-x64-musl": "*"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  }
}
